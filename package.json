{
  "name": "rakitmimpi-nextjs-boilerplate",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Enterprise Next.js 15 App Router Boilerplate by Rakitmimpi Ecosystem (Tailwind CSS, Dark Mode, Stateless JWT Auth, Reusable UI kit primitives, Kubb OpenAPI Codegen, Transparent Backend Reverse-Proxy, and Optional On-Demand Prisma ORM)",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "kubb:gen": "kubb generate --config kubb.config.ts",
    "gen:prisma": "node scripts/init-prisma.mjs",
    "gen:docker": "node scripts/init-docker.mjs",
    "gen:i18n": "node scripts/init-i18n.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.8",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "jose": "^6.0.8",
    "lucide-react": "^1.16.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@kubb/cli": "^3.5.0",
    "@kubb/core": "^3.5.0",
    "@kubb/plugin-client": "^3.5.0",
    "@kubb/plugin-oas": "^3.5.0",
    "@kubb/plugin-react-query": "^3.5.0",
    "@kubb/plugin-ts": "^3.5.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
